{
  "expo": {
    "name": "EdgeEver",
    "slug": "edgeever",
    "scheme": "edgeever",
    "version": "2.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "org.edgeever.mobile",
      "versionCode": 239,
      "adaptiveIcon": {
        "backgroundColor": "#16A06E",
        "backgroundImage": "./assets/icon.png",
        "foregroundImage": "./assets/adaptive-icon-transparent.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow EdgeEver to take photos and insert them into your notes.",
          "microphonePermission": false,
          "photosPermission": "Allow EdgeEver to choose photos to insert into your notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16A06E",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "usesCleartextTraffic": true,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": false
          },
          "android": {
            "enabled": true,
            "multipleShareMimeTypes": [
              "text/plain",
              "image/*"
            ],
            "singleShareMimeTypes": [
              "text/plain",
              "image/*"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    },
    "owner": "scupro"
  }
}
