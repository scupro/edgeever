---
import Container from "@/components/container.astro";
import Features from "@/components/features.astro";
import Guides from "@/components/guides.astro";
import Hero from "@/components/hero.astro";
import Logos from "@/components/logos.astro";
import MarqueeShowcase from "@/components/marquee-showcase.astro";
import Layout from "@/layouts/Layout.astro";

const siteUrl = new URL(Astro.url.pathname, Astro.site).toString();

const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "EdgeEver",
    url: siteUrl,
    inLanguage: "zh-TW",
    description:
      "EdgeEver 是開源、原生支援 AI 的自託管筆記工作區，支援 Cloudflare 與 Docker 自由部署，覆蓋 macOS、Windows、Linux、iOS、Android 與瀏覽器外掛。",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "EdgeEver",
    url: siteUrl,
    codeRepository: "https://github.com/scupro/edgeever",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "macOS, Windows, Linux, iOS, Android, Web, Chrome, Edge, Firefox",
    isAccessibleForFree: true,
    description:
      "EdgeEver 是開源、原生支援 AI 的自託管筆記工作區，保留經典三欄高效工作區體驗（目錄樹 · 筆記列表 · 編輯寫作），支援 ACP 本機 Agent 深度協同、AI 伴侶側邊欄與視覺化圖表筆記，覆蓋 macOS、Windows、Linux、iOS、Android 與瀏覽器外掛，並提供 REST API、MCP 與 ACP 協議支援。",
  },
];
---

<Layout title="" jsonLd={homeJsonLd}>
  <Container>
    <Hero />
    <MarqueeShowcase />
    <Features />
    <Guides />
    <Logos />
  </Container>
</Layout>
